// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  USER
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ActivityLog ActivityLog[]
  Article     Article[]
}

model Product {
  id             String   @id @default(cuid())
  name           String
  description    String
  price          Float
  originalPrice  Float?   // Harga sebelum diskon (dicoret)
  image          String?
  category       String?
  documentFormat String?  // e.g. "Microsoft Word (.docx)", "PDF (.pdf)", "Microsoft Excel (.xlsx)"
  promoStatus    String?  // e.g. "Diskon 50%", "Promo Bundling", null = no promo
  features       String?  // Stored as text, each line is a feature bullet point
  digitalFile    String?
  status         String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  stock          Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  OrderItems OrderItem[]
}

model Order {
  id            String   @id @default(cuid())
  totalAmount   Float
  status        String   @default("PENDING") // PENDING, PAID, EXPIRED, REFUND
  buyerName     String
  buyerEmail    String
  buyerPhone    String?
  paymentId     String?
  paymentMethod String? // TRANSFER, QRIS
  bankName      String? // e.g. BCA, BNI, BRI, MANDIRI
  paymentProof  String?
  expiresAt     DateTime?
  downloadCode  String?  // Kode unik per order, di-generate saat admin approve
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Article {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  content    String
  externalUrl String?
  coverImage String?
  category   String?
  authorName String?  // Optional override for the author's name
  status     String   @default("DRAFT") // DRAFT, PUBLISHED
  isTrending Boolean  @default(false)
  authorId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  content   String
  photo     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lawyer {
  id               String   @id @default(cuid())
  name             String
  photo            String?
  specialization   String
  description      String?
  consultationPrice Float   @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bookings         ConsultationBooking[]
}

model ConsultationBooking {
  id               String   @id @default(cuid())
  lawyerId         String
  clientName       String
  clientEmail      String
  clientPhone      String
  caseDescription  String
  scheduleDate     String   
  scheduleTime     String   
  
  totalAmount      Float
  status           String   @default("PENDING") // PENDING, PAID, REJECTED, COMPLETED
  paymentMethod    String?  // TRANSFER, QRIS
  bankName         String?
  paymentProof     String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lawyer           Lawyer   @relation(fields: [lawyerId], references: [id])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  value     String   @db.Text
  category  String   @default("GENERAL") // e.g. "HOME", "ABOUT", "CONTACT"
  type      String   @default("TEXT") // e.g. "TEXT", "TEXTAREA", "IMAGE"
  updatedAt DateTime @updatedAt
}

model ServiceCarousel {
  id          String   @id @default(cuid())
  name        String
  description String
  imageUrl    String?
  linkUrl     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
